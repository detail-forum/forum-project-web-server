# 이 파일을 application-local.properties 로 복사한 뒤 값을 채운다.
# application-local.properties 는 git에 올리지 않는다.
# 환경 변수(DB_PASSWORD, JWT_SECRET, MAIL_USERNAME, MAIL_PASSWORD)로 넣어도 된다.

spring.datasource.url=jdbc:mysql://localhost:3306/2025_gbsw_spring
spring.datasource.username=root
spring.datasource.password=change-me

spring.jwt.secret=change-me-please-32bytes-minimum-xxxxxxxxxxxxxxxxxxxx

spring.mail.username=your-address@gmail.com
spring.mail.password=your-gmail-app-password
